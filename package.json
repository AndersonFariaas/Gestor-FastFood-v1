{
  "name": "gestor-fastfood",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema de gestão para lanchonetes: PDV, cozinha (KDS), painel de senhas e fechamento de caixa.",
  "license": "GPL-3.0-only",
  "author": "Anderson Farias",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @fastfood/api\" \"npm run dev -w @fastfood/web\"",
    "build": "npm run build -w @fastfood/web",
    "start": "npm run start -w @fastfood/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:import-legacy": "npm run db:import-legacy -w @fastfood/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
