# Copie para .env e ajuste conforme necessário. Todas as variáveis são opcionais.

# Ambiente: production | development
NODE_ENV=production

# Rede: use 127.0.0.1 para permitir acesso apenas nesta máquina
PORT=3000
HOST=0.0.0.0

# Banco SQLite (relativo à pasta apps/api)
DB_PATH=data/fastfood.db

# Duração da sessão de login, em horas (padrão: 7 dias)
SESSION_TTL_HOURS=168

# Defina como true somente se o sistema for servido via HTTPS
COOKIE_SECURE=false

# Senha do usuário "admin" criado no primeiro uso (mín. 8 caracteres).
# Se vazio, uma senha aleatória é gerada e exibida uma única vez no log.
ADMIN_PASSWORD=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
