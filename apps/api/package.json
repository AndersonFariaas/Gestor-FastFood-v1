{
  "name": "@fastfood/api",
  "version": "2.0.0",
  "private": true,
  "description": "API REST + tempo real (Socket.IO) do Gestor FastFood.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env.development --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:import-legacy": "node --env-file-if-exists=.env src/scripts/import-legacy.ts"
  },
  "dependencies": {
    "@fastfood/shared": "*",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
